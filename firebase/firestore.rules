rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner() {
      return isAuthenticated() && (getUserData().role == 'owner' || getUserData().role == 'admin');
    }

    function isManager() {
      return isAuthenticated() && getUserData().role == 'manager';
    }

    function isStaff() {
      return isAuthenticated() && getUserData().role == 'staff';
    }

    function ownsShop(shopId) {
      return isOwner() && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
    }

    function managesShop(shopId) {
      return isManager() && getUserData().shopId == shopId;
    }

    function staffOfShop(shopId) {
      return isStaff() && getUserData().shopId == shopId;
    }

    function canAccessShop(shopId) {
      return ownsShop(shopId) || managesShop(shopId);
    }

    function ownsRecord() {
      return isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    function managesRecord() {
      return isManager() && getUserData().shopId == resource.data.shopId;
    }

    function staffRecord() {
      return isStaff() && getUserData().shopId == resource.data.shopId;
    }

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isOwner());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isOwner());
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Shops
    match /shops/{shopId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (isManager() && getUserData().shopId == shopId) ||
        (isStaff() && getUserData().shopId == shopId)
      );
      allow create: if isOwner() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Managers
    match /managers/{managerId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || request.auth.uid == resource.data.authUid
      );
      allow create: if isOwner() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Staff
    match /staff/{staffId} {
      allow read: if isAuthenticated() && (
        ownsRecord() || managesRecord() ||
        (isStaff() && resource.data.authUid == request.auth.uid)
      );
      allow create: if isAuthenticated() && (isOwner() || isManager());
      allow update: if isAuthenticated() && (ownsRecord() || managesRecord());
      allow delete: if isAuthenticated() && ownsRecord();
    }

    // Sales
    match /sales/{saleId} {
      allow read: if isAuthenticated() && (ownsRecord() || managesRecord());
      allow create: if isAuthenticated() && canAccessShop(request.resource.data.shopId);
      allow update: if isAuthenticated() && canAccessShop(resource.data.shopId);
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Customers
    match /customers/{customerId} {
      allow read: if isAuthenticated() && (ownsRecord() || managesRecord());
      allow create: if isAuthenticated() && canAccessShop(request.resource.data.shopId);
      allow update: if isAuthenticated() && canAccessShop(resource.data.shopId);
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Products
    match /products/{productId} {
      allow read: if isAuthenticated() && (ownsRecord() || managesRecord());
      allow create: if isAuthenticated() && canAccessShop(request.resource.data.shopId);
      allow update: if isAuthenticated() && canAccessShop(resource.data.shopId);
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (ownsRecord() || managesRecord());
      allow create: if isAuthenticated() && canAccessShop(request.resource.data.shopId);
      allow update: if isAuthenticated() && canAccessShop(resource.data.shopId);
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Udhari
    match /udhari/{udhariId} {
      allow read: if isAuthenticated() && (ownsRecord() || managesRecord());
      allow create: if isAuthenticated() && canAccessShop(request.resource.data.shopId);
      allow update: if isAuthenticated() && canAccessShop(resource.data.shopId);
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Inventory
    match /inventory/{itemId} {
      allow read: if isAuthenticated() && (ownsRecord() || managesRecord());
      allow create: if isAuthenticated() && (isOwner() || isManager());
      allow update: if isAuthenticated() && (ownsRecord() || managesRecord());
      allow delete: if isAuthenticated() && ownsRecord();
    }

    // Expenses
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && (ownsRecord() || managesRecord());
      allow create: if isAuthenticated() && (isOwner() || isManager());
      allow update: if isAuthenticated() && (ownsRecord() || managesRecord());
      allow delete: if isAuthenticated() && ownsRecord();
    }

    // Chats
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isOwner() || isManager());
      allow update: if isAuthenticated() && (isOwner() || isManager());
      allow delete: if isAuthenticated() && isOwner();
    }

    // Attendance
    match /attendance/{recordId} {
      allow read: if isAuthenticated() && (
        ownsRecord() || managesRecord() || staffRecord()
      );
      allow create: if isAuthenticated() && (isOwner() || isManager());
      allow update: if isAuthenticated() && (isOwner() || isManager());
    }

    // Payroll
    match /payroll/{payrollId} {
      allow read: if isAuthenticated() && (
        ownsRecord() || managesRecord() || staffRecord()
      );
      allow write: if isAuthenticated() && (isOwner() || isManager());
    }

    // Leave Requests
    match /leaveRequests/{leaveId} {
      allow read: if isAuthenticated() && (
        ownsRecord() || managesRecord() ||
        resource.data.staffUid == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isOwner() || isManager() || resource.data.staffUid == request.auth.uid);
    }

    // Activity Log
    match /activityLog/{logId} {
      allow read: if isAuthenticated() && ownsRecord();
      allow create: if isAuthenticated();
    }

    // Analytics
    match /analytics/{docId} {
      allow read: if isAuthenticated() && (ownsRecord() || managesRecord());
      allow write: if isAuthenticated() && canAccessShop(request.resource.data.shopId);
    }

    // Settings
    match /settings/{ownerId} {
      allow read, write: if isAuthenticated() && request.auth.uid == ownerId;
    }

    // Backup
    match /backup/{backupId} {
      allow read, write: if isOwner() && resource.data.ownerId == request.auth.uid;
      allow create: if isOwner() && request.resource.data.ownerId == request.auth.uid;
    }
  }
}
