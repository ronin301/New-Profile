rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner() {
      return isAuthenticated() && (getUserData().role == 'owner' || getUserData().role == 'admin');
    }

    function isManager() {
      return isAuthenticated() && getUserData().role == 'manager';
    }

    function ownsShop(shopId) {
      return isOwner() && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
    }

    function managesShop(shopId) {
      return isManager() && getUserData().shopId == shopId;
    }

    function canAccessShop(shopId) {
      return ownsShop(shopId) || managesShop(shopId);
    }

    // Query-friendly access checks for list/collection reads. Firestore cannot
    // evaluate get()-based rules (ownsShop) against a query, so owner-wide list
    // queries must authorize off a field stored on each document (ownerId).
    // Every owned record stores `ownerId`; shop-scoped records also store
    // `shopId`, which a manager's own profile is matched against.
    function ownsRecord() {
      return isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    function managesRecord() {
      return isManager() && getUserData().shopId == resource.data.shopId;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isOwner());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    match /shops/{shopId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (isManager() && getUserData().shopId == shopId)
      );
      allow create: if isOwner() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /managers/{managerId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || request.auth.uid == resource.data.authUid
      );
      allow create: if isOwner() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /sales/{saleId} {
      allow read: if isAuthenticated() && (ownsRecord() || managesRecord());
      allow create: if isAuthenticated() && canAccessShop(request.resource.data.shopId);
      allow update: if isAuthenticated() && canAccessShop(resource.data.shopId);
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /customers/{customerId} {
      allow read: if isAuthenticated() && (ownsRecord() || managesRecord());
      allow create: if isAuthenticated() && canAccessShop(request.resource.data.shopId);
      allow update: if isAuthenticated() && canAccessShop(resource.data.shopId);
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /products/{productId} {
      allow read: if isAuthenticated() && (ownsRecord() || managesRecord());
      allow create: if isAuthenticated() && canAccessShop(request.resource.data.shopId);
      allow update: if isAuthenticated() && canAccessShop(resource.data.shopId);
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (ownsRecord() || managesRecord());
      allow create: if isAuthenticated() && canAccessShop(request.resource.data.shopId);
      allow update: if isAuthenticated() && canAccessShop(resource.data.shopId);
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /udhari/{udhariId} {
      allow read: if isAuthenticated() && (ownsRecord() || managesRecord());
      allow create: if isAuthenticated() && canAccessShop(request.resource.data.shopId);
      allow update: if isAuthenticated() && canAccessShop(resource.data.shopId);
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /analytics/{docId} {
      allow read: if isAuthenticated() && (ownsRecord() || managesRecord());
      allow write: if isAuthenticated() && canAccessShop(request.resource.data.shopId);
    }

    match /settings/{ownerId} {
      allow read, write: if isAuthenticated() && request.auth.uid == ownerId;
    }

    match /backup/{backupId} {
      allow read, write: if isOwner() && resource.data.ownerId == request.auth.uid;
      allow create: if isOwner() && request.resource.data.ownerId == request.auth.uid;
    }
  }
}
